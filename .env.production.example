# Copy to .env.production on the server. Never commit the real file.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
DB_HOST=db
DB_PORT=3306
DB_NAME=bangkok_traffic
DB_USER=traffic_app
DB_PASSWORD=replace-with-a-long-random-app-password
APP_ENV=production
RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
EXPORT_RATE_LIMIT=6 per minute
VEHICLES_RATE_LIMIT=30 per minute
EXPORT_MAX_ROWS=50000
HOST_PORT=8000
WEB_CONCURRENCY=2
WEB_THREADS=4
WEB_TIMEOUT=120
# Keep 0 for direct access. Set to 1 only behind exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0
# For an external MySQL provider, set its CA certificate path inside the container.
# DB_SSL_CA=/run/secrets/mysql-ca.pem
